# Config for the text->3D pipeline tools (generate_3d, wait_for_3d_job).
#
# Local/dev: copy this file to `.env` in the same directory and fill in values.
# Production: inject these as real environment variables instead — real env
# always wins over the .env file (load_dotenv runs with override=False), so the
# .env is ignored/absent in any real deployment. Never commit a filled-in .env.

# Base URL of YOUR n8n instance hosting the 3D webhooks. (required for
# generate_3d / wait_for_3d_job). Import the workflows in ../n8n/ into your own
# n8n first, then set this. No default - this MCP is instance-agnostic.
# Example: https://n8n.example.com
THREED_WEBHOOK_BASE=

# Shared secret sent as the "X-API-Key" header to the gated n8n webhooks.
# Must match the value you set in the "Check API Key" IF nodes of both imported
# workflows. (required for generate_3d / wait_for_3d_job)
THREED_WEBHOOK_API_KEY=
