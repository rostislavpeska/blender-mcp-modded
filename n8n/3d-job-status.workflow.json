{
  "name": "3D Job Status (poll fal)",
  "nodes": [
    {
      "id": "cccc1111-2222-4333-8444-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "onError": "continueRegularOutput",
      "parameters": {
        "httpMethod": "POST",
        "path": "3d-job-status",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "eeee1111-2222-4333-8444-000000000001",
      "name": "Check API Key",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [180, 60],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "id": "apikey-check",
              "leftValue": "={{ $json.headers['x-api-key'] }}",
              "rightValue": "REPLACE_WITH_YOUR_WEBHOOK_API_KEY",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "eeee1111-2222-4333-8444-000000000002",
      "name": "Reject",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [380, 200],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"error\": \"unauthorized\" }",
        "options": { "responseCode": 401 }
      }
    },
    {
      "id": "cccc1111-2222-4333-8444-000000000002",
      "name": "fal status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [400, -60],
      "notes": "Attach the same 'Header Auth' fal credential (Authorization: Key <YOUR_FAL_KEY>).",
      "parameters": {
        "method": "GET",
        "url": "={{ $json.body.status_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 20000 }
      }
    },
    {
      "id": "cccc1111-2222-4333-8444-000000000003",
      "name": "IF completed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [620, -60],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "COMPLETED",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      }
    },
    {
      "id": "cccc1111-2222-4333-8444-000000000004",
      "name": "fal result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [840, -140],
      "notes": "Attach the same 'Header Auth' fal credential.",
      "parameters": {
        "method": "GET",
        "url": "={{ $('Webhook').item.json.body.response_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 20000 }
      }
    },
    {
      "id": "cccc1111-2222-4333-8444-000000000005",
      "name": "Respond done",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1060, -140],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"completed\", \"glb_url\": ($json.model_mesh && $json.model_mesh.url) || ($json.model_glb && $json.model_glb.url) || null } }}"
      }
    },
    {
      "id": "cccc1111-2222-4333-8444-000000000006",
      "name": "Respond pending",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [840, 100],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": $json.status } }}"
      }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Check API Key", "type": "main", "index": 0 }]] },
    "Check API Key": {
      "main": [
        [{ "node": "fal status", "type": "main", "index": 0 }],
        [{ "node": "Reject", "type": "main", "index": 0 }]
      ]
    },
    "fal status": { "main": [[{ "node": "IF completed", "type": "main", "index": 0 }]] },
    "IF completed": {
      "main": [
        [{ "node": "fal result", "type": "main", "index": 0 }],
        [{ "node": "Respond pending", "type": "main", "index": 0 }]
      ]
    },
    "fal result": { "main": [[{ "node": "Respond done", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
